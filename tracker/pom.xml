         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         										 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.edu_sharing</groupId>
    <artifactId>edu_sharing-community-repository-plugin-elastic</artifactId>
    <version>git</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>edu_sharing-community-repository-plugin-elastic-tracker</artifactId>
  <version>git</version>

  <name>edu_sharing-community-repository-plugin-elastic-tracker</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <spring.boot.version>4.1.2</spring.boot.version>
    <!-- overrides the elasticsearch client managed by spring-boot-dependencies (9.4.x), must match the server -->
    <elasticsearch-client.version>9.5.6</elasticsearch-client.version>
    <!-- security overrides of versions managed by spring-boot-dependencies: the BOM is imported, so its own
         properties can't be overridden. Pin them explicitly in dependencyManagement before the
         spring-boot-dependencies import (first import wins), currently none needed for spring boot 4.1.2 -->
    <!-- the 80+ MB fat jar is only consumed within this reactor (docker image, compose);
         nothing pulls it from the maven repository, so the upload is skipped -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>



  <build>
    <plugins>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring.boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
            <phase>package</phase>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>openapi</id>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <includeArtifactIds>
                edu_sharing-community-repository-backend-services-rest-api
              </includeArtifactIds>
              <excludes>META-INF/**</excludes>
              <outputDirectory>${project.build.directory}/api</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>7.27.0</version>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
            <!--            <phase>generate-sources</phase>-->
            <configuration>
              <inputSpec>${project.build.directory}/api/openapi.json</inputSpec>
              <generatorName>java</generatorName>

              <output>${project.build.directory}/generated-sources/openapi</output>
              <apiPackage>org.edu_sharing.generated.repository.backend.services.rest.client.api</apiPackage>
              <modelPackage>org.edu_sharing.generated.repository.backend.services.rest.client.model</modelPackage>
              <invokerPackage>org.edu_sharing.generated.repository.backend.services.rest.client.handler</invokerPackage>
              <!--              <skipValidateSpec>false</skipValidateSpec>-->
              <library>webclient</library>
              <configOptions>
                <dateLibrary>java8</dateLibrary>
                <serializationLibrary>jackson</serializationLibrary>
                <useJakartaEe>true</useJakartaEe>
                <useSpringBoot4>true</useSpringBoot4>
                <useJackson3>true</useJackson3>
                <generateBuilders>true</generateBuilders>
                <!--                <idea>true</idea>-->
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>

  </build>

  <dependencyManagement>

    <dependencies>

